# バックエンド環境変数のサンプル
# 本番は Supabase Transaction Pooler（port 6543）を使うこと
# 例: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# JWT署名用シークレット（本番では十分に長いランダム文字列に）
JWT_SECRET=

# Supabase Storage用
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# CORS許可オリジン（カンマ区切り）。未指定なら全開（ローカル開発用）
# 本番は Vercel のフロントドメインを指定
# 例: CORS_ORIGIN=https://taskboard.vercel.app
CORS_ORIGIN=

# Render は PORT 環境変数を自動注入するので、本番では設定不要
PORT=3001
